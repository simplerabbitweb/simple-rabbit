Options +FollowSymLinks
RewriteEngine On

# --- Disable mod_dir trailing-slash redirect so /about doesn't 301 to /about/ ---
# (the /about directory now exists for /about/simple-rabbit, but /about itself
#  must continue to serve /about.html)
DirectorySlash Off

# --- Serve /about from about.html (directory shadowing fix) ---
RewriteRule ^about/?$ /about.html [L]

# --- Redirect merged blog post ---
RewriteRule ^blog/google-business-profile-not-getting-clicks/?$ /blog/google-business-profile-mistakes-wellness-practices [R=301,L]

# --- Redirect /audit to /website-audit ---
RewriteRule ^audit$ /website-audit [R=301,L]

# --- Redirect old playbook URLs to /fully-booked ---
RewriteRule ^the-fully-booked-practice-playbook/?$ /fully-booked [R=301,L]
RewriteRule ^playbook/?$ /fully-booked [R=301,L]

# --- Service sub-pages → /services ---
RewriteRule ^website-design/?$ /services [R=301,L]
RewriteRule ^ongoing-support/?$ /services [R=301,L]

# --- Deleted blog posts → /articles ---
RewriteRule ^blog/ai-search-visibility-service-business/?$ /articles [R=301,L]
RewriteRule ^blog/nj-businesses-need-solid-website/?$ /articles [R=301,L]
RewriteRule ^blog/about-page-service-business/?$ /articles [R=301,L]

# --- County/location pages → /articles ---
RewriteRule ^web-design-bergen-county-nj/?$ /articles [R=301,L]

# --- Force HTTPS ---
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Redirect www → non-www ---
RewriteCond %{HTTP_HOST} ^www\.simplerabbit\.studio [NC]
RewriteRule ^ https://simplerabbit.studio%{REQUEST_URI} [L,R=301]

# Redirect .html URLs to clean URLs (301 permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve clean URLs by appending .html internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# --- HSTS: tell browsers to always use HTTPS ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Prevent HTML pages from being cached so updates show immediately
<FilesMatch "\.(html)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</FilesMatch>

# Allow images, SVG, JS to be cached for 1 week
<FilesMatch "\.(png|jpg|jpeg|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=604800"
</FilesMatch>
