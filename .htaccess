Options +FollowSymLinks
RewriteEngine On

# --- Disable mod_dir trailing-slash redirect so /about doesn't 301 to /about/ ---
# (the /about directory now exists for /about/simple-rabbit, but /about itself
#  must continue to serve /about.html)
DirectorySlash Off

# --- Serve /about from about.html (directory shadowing fix) ---
RewriteRule ^about/?$ /about.html [L]

# --- Serve /portfolio from portfolio.html (directory shadowing fix) ---
RewriteRule ^portfolio/?$ /portfolio.html [L]

# --- Redirect merged/deleted blog posts ---
RewriteRule ^blog/local-seo-for-private-practices/?$ /blog/local-seo-for-private-pay-practices [R=301,L]
RewriteRule ^blog/google-business-profile-not-getting-clicks/?$ /articles [R=301,L]
RewriteRule ^blog/google-business-profile-mistakes-wellness-practices/?$ /articles [R=301,L]
RewriteRule ^blog/why-private-pay-physicians-asking-about-email/?$ /blog/why-private-practices-asking-about-email [R=301,L]

# --- Redirect /audit + old /website-audit + old /blind-spot-breakdown to /website-wellness-check ---
RewriteRule ^audit$ /website-wellness-check [R=301,L]
RewriteRule ^website-audit(\.html)?/?$ /website-wellness-check [R=301,L]
RewriteRule ^blind-spot-breakdown(\.html)?/?$ /website-wellness-check [R=301,L]

# --- Deleted ACRR assessment page (and old checklist URL) → homepage ---
RewriteRule ^acrr-assessment(\.html)?/?$ / [R=301,L]
RewriteRule ^acrr-checklist(\.html)?/?$ / [R=301,L]
RewriteRule ^checklist-thank-you(\.html)?/?$ / [R=301,L]
RewriteRule ^ai-front-desk(\.html)?/?$ / [R=301,L]

# --- Renamed landing page: website-review → missing-marketing-checklist ---
RewriteRule ^website-review(\.html)?/?$ /missing-marketing-checklist [R=301,L]

# --- Deleted ACRR tool page → missing-marketing-checklist ---
RewriteRule ^acrr-tool(\.html)?/?$ /missing-marketing-checklist [R=301,L]

# --- Redirect old playbook URLs to /fully-booked ---
RewriteRule ^the-fully-booked-practice-playbook/?$ /fully-booked [R=301,L]
RewriteRule ^playbook/?$ /fully-booked [R=301,L]

# --- /services page removed → redirect it and its former sub-page URLs ---
RewriteRule ^services/?$ / [R=301,L]
RewriteRule ^website-design/?$ /functional-medicine-website-design [R=301,L]
RewriteRule ^ongoing-support/?$ / [R=301,L]

# --- Deleted blog posts → /articles ---
RewriteRule ^blog/(ai-search-visibility-service-business|nj-businesses-need-solid-website|about-page-service-business)/?$ /articles [R=301,L]

# --- Deleted county + specialty landing pages → homepage ---
RewriteRule ^web-design-(bergen|essex|hudson|morris|passaic|sussex|warren)-county-nj/?$ / [R=301,L]
RewriteRule ^web-design-(rockland|westchester)-county-ny/?$ / [R=301,L]
RewriteRule ^(aesthetics|cash-pay-psychiatry|concierge-primary-care|fertility-practice|functional-medicine|holistic-gynecology|lactation-postnatal|menopause-practice|pelvic-floor-physical-therapy)-web-design/?$ / [R=301,L]

# --- Force HTTPS ---
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Redirect www → non-www ---
RewriteCond %{HTTP_HOST} ^www\.simplerabbit\.studio [NC]
RewriteRule ^ https://simplerabbit.studio%{REQUEST_URI} [L,R=301]

# Redirect .html URLs to clean URLs (301 permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve clean URLs by appending .html internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# --- HSTS: tell browsers to always use HTTPS ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Prevent HTML pages from being cached so updates show immediately
<FilesMatch "\.(html)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</FilesMatch>

# Allow images, SVG, JS to be cached for 1 week
<FilesMatch "\.(png|jpg|jpeg|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=604800"
</FilesMatch>
